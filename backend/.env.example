# 複製這份成 .env 再填值：cp .env.example .env
# .env 已被 .gitignore 排除，不會進 git。

# 後端埠號
PORT=3000

# 資料庫（AWS Aurora PostgreSQL，database-1 的「寫入器端點」）
# 用 IAM 身分驗證，所以沒有 DB 密碼；本機開發前先在終端機執行 `aws login`。
DB_HOST=database-1.cluster-xxxxxxxx.ap-southeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
AWS_REGION=ap-southeast-2

# 之後接 AI 時再加（金鑰只放這裡，不要貼到群組或給 AI）
# ANTHROPIC_API_KEY=
